{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(hyprctl clients *)",
      "Bash(git log *)",
      "Bash(rg *)",
      "Bash(ls *)"
    ],
    "deny": [
      "NotebookEdit",
      "Bash(supabase db push *)",
      "Bash(git push*)",
      "Bash(git am*)",
      "Bash(git cherry-pick*)",
      "Bash(git revert*)",
      "Bash(git merge*)",
      "Bash(git rebase*)",
      "Bash(gh pr merge*)",
      "Bash(lazygit*)",
      "Read(//home/baz/.ssh/**)",
      "Edit(//home/baz/.ssh/**)",
      "Read(//home/baz/.config/gh/hosts.yml)",
      "Read(//home/baz/.config/chromium/**)",
      "Read(//home/baz/.config/google-chrome/**)",
      "Read(//home/baz/.config/google-chrome-beta/**)",
      "Read(//home/baz/.config/google-chrome-unstable/**)",
      "Read(//home/baz/.config/BraveSoftware/**)",
      "Read(//home/baz/.config/microsoft-edge/**)",
      "Read(//home/baz/.config/microsoft-edge-dev/**)",
      "Read(//home/baz/.config/mozilla/**)",
      "Read(//home/baz/.config/obsidian/**)",
      "Read(//home/baz/.config/cliamp/spotify_credentials.json)",
      "Read(//home/baz/.local/share/keyrings/**)",
      "Read(~/**/supabase/seed/private/*)",
      "Read(~/**/.env)",
      "Read(~/**/.env.*)"
    ],
    "ask": [
      "Bash(vercel *)",
      "Bash(dangerouslyDisableSandbox:true)",
      "Bash(stow)",
      "Bash(gh pr create*)",
      "Bash(git add*)",
      "Bash(git stage*)",
      "Bash(git commit*)",
      "Edit(**/.claude/settings*.json)",
      "Edit(~/.claude/settings*.json)",
      "Edit(**/.mcp.json)"
    ],
    "defaultMode": "default"
  },
  "disableClaudeAiConnectors": true,
  "disableWorkflows": true,
  "enableArtifact": false,
  "statusLine": {
    "type": "command",
    "command": "jq -r --arg h \"$HOME\" '(.context_window.current_usage // {}) as $u | (($u.input_tokens // 0) + ($u.cache_creation_input_tokens // 0) + ($u.cache_read_input_tokens // 0)) as $t | (.context_window.context_window_size // 0) as $w | (if $w > 0 then (($t / $w * 1000 | round) / 10) else 0 end) as $p | (if $t >= 1000 then \"\\(($t / 100 | round) / 10)K\" else \"\\($t)\" end) as $tok | (if $p >= 80 then \"\\u001b[31m\" elif $p >= 50 then \"\\u001b[33m\" else \"\\u001b[32m\" end) as $pc | \"\\u001b[2m[\\u001b[0m\\u001b[36m\\(.model.display_name)\\u001b[0m \\u001b[2m·\\u001b[0m \\u001b[35m\\(.effort.level // \"-\")\\u001b[0m\\u001b[2m]\\u001b[0m \\u001b[34m\\((.cwd // .workspace.current_dir // \"\") | sub(\"^\"+$h; \"~\"))\\u001b[0m \\u001b[2m·\\u001b[0m \\($pc)\\($tok) (\\($p)%)\\u001b[0m\"'",
    "padding": 0
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "code-review@claude-plugins-official": false,
    "skill-creator@claude-plugins-official": false,
    "mattpocock-skills@claude-plugins-official": true,
    "github@claude-plugins-official": true
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "network": {
      "allowedDomains": ["registry.npmjs.org", "*.github.com", "github.com"]
    },
    "filesystem": {
      "allowWrite": ["~/dotfiles", "~/omarchy-setup"],
      "denyRead": [
        "~/projects/adventure-journal/.env",
        "~/projects/adventure-journal/.env.development",
        "~/projects/adventure-journal/.env.development.local",
        "~/projects/adventure-journal/.env.production",
        "~/projects/adventure-journal/supabase/seed/private"
      ]
    },
    "credentials": {
      "files": [
        {
          "path": "~/.ssh",
          "mode": "deny"
        },
        {
          "path": "~/.config/gh/hosts.yml",
          "mode": "deny"
        },
        {
          "path": "~/.config/chromium",
          "mode": "deny"
        },
        {
          "path": "~/.config/google-chrome",
          "mode": "deny"
        },
        {
          "path": "~/.config/BraveSoftware",
          "mode": "deny"
        },
        {
          "path": "~/.config/microsoft-edge",
          "mode": "deny"
        },
        {
          "path": "~/.config/mozilla",
          "mode": "deny"
        },
        {
          "path": "~/.config/obsidian",
          "mode": "deny"
        },
        {
          "path": "~/.config/cliamp/spotify_credentials.json",
          "mode": "deny"
        },
        {
          "path": "~/.local/share/keyrings",
          "mode": "deny"
        }
      ],
      "envVars": [
        {
          "name": "SUPABASE_SERVICE_ROLE_KEY",
          "mode": "deny"
        },
        {
          "name": "VERCEL_TOKEN",
          "mode": "deny"
        },
        {
          "name": "SUPABASE_ROLE_KEY",
          "mode": "deny"
        },
        {
          "name": "SUPABASE_SECRET_KEY",
          "mode": "deny"
        },
        {
          "name": "SUPABASE_INTERNAL_SECRET_KEY",
          "mode": "deny"
        },
        {
          "name": "SUPABASE_ACCESS_TOKEN",
          "mode": "deny"
        },
        {
          "name": "SUPABASE_DB_PASSWORD",
          "mode": "deny"
        },
        {
          "name": "SUPABASE_S3_ACCESS_KEY_ID",
          "mode": "deny"
        },
        {
          "name": "SUPABASE_S3_SECRET_ACCESS_KEY",
          "mode": "deny"
        },
        {
          "name": "SUPABASE_AUTH_GOOGLE_SECRET",
          "mode": "deny"
        },
        {
          "name": "OPENAI_API_KEY",
          "mode": "deny"
        },
        {
          "name": "SENTRY_AUTH_TOKEN",
          "mode": "deny"
        }
      ]
    },
    "excludedCommands": ["docker *"]
  },
  "spellcheck": {
    "enabled": true
  },
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "high"
    },
    "claude-fable-5-1": {
      "effortLevel": "high"
    }
  },
  "feedbackSurveyRate": 0,
  "feedbackDrafts": "off",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "autoCompactWindow": 142000,
  "autoUpdatesChannel": "stable",
  "theme": "auto",
  "editorMode": "vim",
  "autoCompactEnabled": false,
  "fileCheckpointingEnabled": true
}
