{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(hyprctl clients *)",
      "Bash(git log *)",
      "Bash(rg *)",
      "Bash(ls *)"
    ],
    "deny": [
      "Bash(supabase db push *)",
      "Bash(git push*)",
      "Bash(git am*)",
      "Bash(git cherry-pick*)",
      "Bash(git revert*)",
      "Bash(git merge*)",
      "Bash(git rebase*)",
      "Bash(gh pr merge*)",
      "Bash(lazygit*)",
      "Read(//home/baz/.ssh/**)",
      "Edit(//home/baz/.ssh/**)",
      "Read(//home/baz/.config/gh/hosts.yml)",
      "Read(//home/baz/.config/chromium/**)",
      "Read(//home/baz/.config/google-chrome/**)",
      "Read(//home/baz/.config/google-chrome-beta/**)",
      "Read(//home/baz/.config/google-chrome-unstable/**)",
      "Read(//home/baz/.config/BraveSoftware/**)",
      "Read(//home/baz/.config/microsoft-edge/**)",
      "Read(//home/baz/.config/microsoft-edge-dev/**)",
      "Read(//home/baz/.config/mozilla/**)",
      "Read(//home/baz/.config/obsidian/**)",
      "Read(//home/baz/.config/cliamp/spotify_credentials.json)",
      "Read(//home/baz/.local/share/keyrings/**)"
    ],
    "ask": [
      "Bash(vercel *)",
      "Bash(dangerouslyDisableSandbox:true)",
      "Bash(stow)",
      "Bash(gh pr create*)",
      "Bash(git add*)",
      "Bash(git stage*)",
      "Bash(git commit*)",
      "Edit(**/.claude/settings*.json)",
      "Edit(~/.claude/settings*.json)",
      "Edit(**/.mcp.json)"
    ],
    "defaultMode": "plan"
  },
  "model": "opus[1m]",
  "statusLine": {
    "type": "command",
    "command": "jq -r --arg h \"$HOME\" '(.context_window.used_percentage // 0) as $p | (if $p >= 80 then \"\\u001b[31m\" elif $p >= 50 then \"\\u001b[33m\" else \"\\u001b[32m\" end) as $pc | \"\\u001b[2m[\\u001b[0m\\u001b[36m\\(.model.display_name)\\u001b[0m \\u001b[2m·\\u001b[0m \\u001b[35m\\(.effort.level // \"-\")\\u001b[0m\\u001b[2m]\\u001b[0m \\u001b[34m\\((.cwd // .workspace.current_dir // \"\") | sub(\"^\"+$h; \"~\"))\\u001b[0m \\u001b[2m·\\u001b[0m \\($pc)\\($p)%\\u001b[0m \\u001b[2mcontext\\u001b[0m\"'",
    "padding": 0
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "network": {
      "allowedDomains": ["registry.npmjs.org", "*.github.com", "github.com"]
    },
    "filesystem": {
      "allowWrite": ["~/dotfiles", "~/omarchy-setup"]
    },
    "credentials": {
      "files": [
        {
          "path": "~/.ssh",
          "mode": "deny"
        },
        {
          "path": "~/.config/gh/hosts.yml",
          "mode": "deny"
        },
        {
          "path": "~/.config/chromium",
          "mode": "deny"
        },
        {
          "path": "~/.config/google-chrome",
          "mode": "deny"
        },
        {
          "path": "~/.config/BraveSoftware",
          "mode": "deny"
        },
        {
          "path": "~/.config/microsoft-edge",
          "mode": "deny"
        },
        {
          "path": "~/.config/mozilla",
          "mode": "deny"
        },
        {
          "path": "~/.config/obsidian",
          "mode": "deny"
        },
        {
          "path": "~/.config/cliamp/spotify_credentials.json",
          "mode": "deny"
        },
        {
          "path": "~/.local/share/keyrings",
          "mode": "deny"
        }
      ],
      "envVars": [
        {
          "name": "SUPABASE_SERVICE_ROLE_KEY",
          "mode": "deny"
        },
        {
          "name": "VERCEL_TOKEN",
          "mode": "deny"
        }
      ]
    },
    "excludedCommands": ["docker *"]
  },
  "spellcheck": {
    "enabled": true
  },
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "xhigh"
    },
    "claude-fable-5": {
      "effortLevel": "xhigh"
    }
  },
  "autoUpdatesChannel": "stable",
  "theme": "auto",
  "editorMode": "vim",
  "fileCheckpointingEnabled": true,
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true
  }
}
